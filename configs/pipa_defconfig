# Kernel configuration of pipa: the generic CPU, interrupt, timer and platform expert path, the source corecrypto and
# pthread providers, NativeAES, the SM8250 UFS root and the owner root chain of UniXNU-tb128fu. CONFIG_XNU_<NAME> becomes
# XNU_<NAME> for the kernel build.
#
# The display stack of UniXNU-tb128fu without its GPU: NATIVE_LEGACY_DISPLAY (the firmware frame buffer, QuartzCore's CPU
# renderer). Left out until its inputs exist: NATIVE_ADRENO (Adreno 650).
# SHENG_PMGR links the original-PMGR bridge (scripts/build-platform-power.py),
# without which the original AMFI panics with "No PMGR". On the QEMU board the same kernel draws nothing through XNU's
# video console despite -v: after the entry probe bars, the panic screen is the only kernel output on the frame buffer.

CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_SHENG_PMGR=y
# NativeUfs of drivers/NativeUfs (pipa branch, SM8250 constants) with the VerifiedRoot owner policy, as on UniXNU-tb128fu: the
# kernel carries only the 395-byte owner key (build/verified-root-key); the signed OS/SystemOS envelopes are in the userdata
# policy directory (SHNGPOL1) and are read at run time. userdata holds UniXNU-tb128fu's image (the same IPSW and owner key;
# the image does not depend on the board).
CONFIG_XNU_NATIVE_UFS=y
# Verified variant: its root authorization query is what the owner chain below calls. No virtio device exists on this
# board, so its own block transport never configures.
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE="{tree}/build/native-virtio-block-verified/libNativeVirtioBlock.a"
# The Data seed: a packed APFS scratch volume published as a RAM block device.
CONFIG_XNU_NATIVE_RAM_BLOCK=y
# Owner root chain, the same ladder as UniXNU-tb128fu and UniXNU-sheng: audit/trust the verified root, mount the SystemOS
# cryptex as the cache carrier, publish the boot manifest, then mount the scratch Data volume.
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_OWNER_CACHE_VOLUME_UUID="8846FE78-2910-4297-AF97-D59BB6F8FC16"
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="73F1FA24-4189-446D-96D4-FB6324EBE955"
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE="{tree}/build/verified-root-key/libVerifiedRootKey.a"
# The boot progress hooks, implemented by the board's ramoops kernel log (package/BootRamoops.c, scripts/build-boot-progress.py)
# instead of sheng's progress page: stages, process events and the message buffer go into the stock ramoops console zone.
# STANDALONE: the build does not insist on the progress page's inputs.
CONFIG_XNU_BOOT_PROGRESS=y
CONFIG_XNU_BOOT_PROGRESS_STANDALONE=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# Run board.toml's [kernel] archives before the kernel link (without it a newly listed archive is missing at the link).
CONFIG_XNU_BUILD_ARCHIVES=y
# No-op hooks for probes of the left-out components (scripts/build-link-stubs.py).
CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/link-stubs/libLinkStubs.a"
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
# The display, key store stand-in and HID input (scripts/build-native-legacy-display.py, drivers/NativeMobileDisplay of the
# pipa branch): IOMobileGraphicsFamily loaded from bsd_init, NativeLegacyDisplay on the firmware frame buffer.
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
# NativeAdreno for the Adreno 650 (scripts/build-native-adreno-a650.py: the a6xx GPU half, the GMU's SMMU context, the HFI kit
# and package/A650Gmu.c); no personality, the board's GPU probe (package/GpuProbe.cpp) drives it.
CONFIG_XNU_NATIVE_ADRENO=y
CONFIG_XNU_ARMVIRT_PLATFORM=n
